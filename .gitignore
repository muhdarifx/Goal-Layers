# Only reviewed project content is eligible by default.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/README.md
!/LICENSE
!/src/
!/web/
!/tests/
# Never publish local runtime state, credentials or test output.
**/node_modules/
**/target/
**/data/
**/work/
**/.lean-gate/
**/.env
**/.env.*
**/*.sqlite*
**/*.db*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
**/*.webm
**/test-results/
**/playwright-report/


# Reviewed README media only.
!/docs/
/docs/*
!/docs/media/
/docs/media/*
!/docs/media/goal-layers-tree.gif
!/docs/media/bitcoin.svg
!/docs/media/solana.svg

# Local publishing notes and generated files, including nested output.
/docs/local/
/goal-layers.exe
**/*.tmp
**/*.bak
**/*.pdb
**/*.dmp
**/.DS_Store
**/Thumbs.db
**/coverage/
